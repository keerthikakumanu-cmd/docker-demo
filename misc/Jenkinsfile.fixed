node {
   def commit_id
   stage('Preparation') {
     checkout scm
     sh "git rev-parse --short HEAD > .git/commit-id"
     commit_id = readFile('.git/commit-id').trim()
   }
   stage('test') {
     // 🟢 ADDED: Version fix wrapper around the native pull and inside block
     withEnv(['DOCKER_API_VERSION=1.45']) {
       def myTestContainer = docker.image('node:16')
       myTestContainer.pull()
       myTestContainer.inside {
         sh 'npm install --only=dev'
         sh 'npm test'
       }
     }
   }
   stage('test with a DB') {
     // 🟢 ADDED: Version fix wrapper around the database lifecycle
     withEnv(['DOCKER_API_VERSION=1.45']) {
       def mysql = docker.image('mysql').run("-e MYSQL_ALLOW_EMPTY_PASSWORD=yes") 
       def myTestContainer = docker.image('node:16')
       myTestContainer.pull()
       myTestContainer.inside("--link ${mysql.id}:mysql") { // using linking, mysql will be available at host: mysql, port: 3306
            sh 'npm install --only=dev' 
            sh 'npm test'                     
       }                                    
       mysql.stop()
     }
   }                                      
   stage('docker build/push') {            
     // 🟢 ADDED: Version fix wrapper around the registry block
     withEnv(['DOCKER_API_VERSION=1.45']) {
       docker.withRegistry('https://index.docker.io/v2/', 'dockerhub') {
         // Note: Split build and push into two steps to prevent Groovy compilation errors
         def app = docker.build("wardviaene/docker-nodejs-demo:${commit_id}", '.')
         app.push()
       }                                      
     }
   }                                        
}
