// This is a test push for automatic webhooks 2!
node {
   def commit_id
   stage('Preparation') {
     checkout scm
     sh "git rev-parse --short HEAD > .git/commit-id"
     commit_id = readFile('.git/commit-id').trim()
   }
   stage('test') {
     withEnv(['DOCKER_API_VERSION=1.45']) {
       def myTestContainer = docker.image('node:16')
       myTestContainer.pull()
       myTestContainer.inside {
         sh 'npm install --only=dev'
         sh 'npm test'
       }
     }
   }
   stage('test with a DB') {
     withEnv(['DOCKER_API_VERSION=1.45']) {
       def mysql = docker.image('mysql:5.7').run("-e MYSQL_ALLOW_EMPTY_PASSWORD=yes --health-cmd='mysqladmin ping' --health-interval=2s") 
       sh "sleep 5"
       def myTestContainer = docker.image('node:16')
       myTestContainer.pull()
       myTestContainer.inside("--link ${mysql.id}:mysql") { 
            sh 'npm install --only=dev' 
            sh 'npm test'                     
       }                                    
       mysql.stop()
     }
   }                                      
   stage('docker build/push') {            
     // 🎯 FIX: We securely bind the credentials to plain shell variables directly from the vault
     withCredentials([usernamePassword(credentialsId: 'dockerhub-final', passwordVariable: 'DOCKER_TOKEN', usernameVariable: 'DOCKER_USER')]) {
       withEnv(['DOCKER_API_VERSION=1.45']) {
         
         echo "Executing clean CLI authentication bypass..."
         
         // 1. Log in securely using standard terminal pipes
         sh "echo \$DOCKER_TOKEN | docker login -u \$DOCKER_USER --password-stdin"
         
         // 2. Natively build the artifact tag
         sh "docker build -t keerthikumar45/docker-nodejs-demo:${commit_id} ."
         
         // 3. Push it directly to the public registry
         sh "docker push keerthikumar45/docker-nodejs-demo:${commit_id}"
         
         echo "Image successfully shipped!"
       }
     }
   }                                        
}
